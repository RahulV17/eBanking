# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ebanking
DB_UN=your_db_username
DB_PWD=your_db_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Configuration
